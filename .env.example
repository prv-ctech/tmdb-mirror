# Local Rust stack behavior template.
# The canonical deployment uses deploy/env.production.example plus file-backed
# secrets under deploy/secrets/. Never put real credentials in this file.

TMDB_ENVIRONMENT=development
TMDB_API_BASE_URL=https://api.themoviedb.org/3
TMDB_RATE_LIMIT=45
TMDB_MAX_CONNECTIONS=20
TMDB_MAX_ATTEMPTS=4
TMDB_REQUEST_TIMEOUT_SECONDS=30
TMDB_ENABLE_SCHEDULER=false
TMDB_ENABLE_DAILY_EXPORT=false

# The application reads these from Docker secrets in Compose deployments.
# TMDB_READ_ACCESS_TOKEN_FILE=/run/secrets/tmdb_read_access_token
# TMDB_API_KEY_FILE=/run/secrets/tmdb_api_key

ALLOW_LOCAL_MEDIA=true
TMDB_MEDIA_BASE_URL=http://127.0.0.1:8090/media
# Set this only when a Trawl instance is available.
# TMDB_TRAWL_BASE_URL=http://<trawl-host>:8191

# Listener defaults for a local Rust process.
TMDB_API_BIND=0.0.0.0:8080
TMDB_ADMIN_BIND=0.0.0.0:8081
