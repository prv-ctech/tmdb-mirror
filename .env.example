# Copy this file to .env when using docker-compose-example.yaml.
# Docker Compose automatically reads .env from the project directory. This file
# contains behavior and URLs only; never put passwords, API keys, or the TMDB
# read token here.
#
# The Compose file supplies the internal database host/port, database roles, and
# *_PASSWORD_FILE/TMDB_*_FILE paths. There is intentionally no DATABASE_URI in
# this file: credentials stay in deploy/secrets/ and are mounted as Docker
# secrets.

TMDB_ENVIRONMENT=production
TMDB_API_BASE_URL=https://api.themoviedb.org/3
TMDB_MEDIA_BASE_URL=http://media.example.invalid:8090/media
# Replace this reserved hostname with the URL reachable from the worker. Leave
# local media enabled only when the media worker should download images.
TMDB_TRAWL_BASE_URL=http://trawl.example.invalid:8191
ALLOW_LOCAL_MEDIA=true

TMDB_RATE_LIMIT=45
TMDB_MAX_CONNECTIONS=20
TMDB_MAX_ATTEMPTS=4
TMDB_REQUEST_TIMEOUT_SECONDS=30
TMDB_WORKER_ID=tmdb-worker-primary
TMDB_IMAGE_WORKER_ID=tmdb-media-primary
TMDB_ENABLE_SCHEDULER=true
TMDB_SCHEDULER_INTERVAL_SECONDS=60
TMDB_ENABLE_DAILY_EXPORT=true

# The published host ports are in docker-compose-example.yaml. Change only the
# left-hand side of "8080:8080" or "8090:8090" there if another host port is
# required; the application still listens on the fixed container ports.
