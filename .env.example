# Safe template. Copy to a mode-600 runtime file, replace placeholders, and
# keep credentials out of Git. Container paths are fixed: /config and /media.

# Deployment mode; production requires real database and admin credentials.
TMDB_ENVIRONMENT=production
# Human-readable worker schedules and terminal log timestamps. Database values
# remain stored as UTC, including all API timestamps.
TZ=America/New_York

# Host-side production bindings. Keep these values in the ignored runtime
# environment; Compose maps them to the fixed container paths and ports.
# Replace this loopback example with the existing LAN address for Unraid.
TMDB_DEPLOY_HOST_IP=127.0.0.1
TMDB_API_HOST_PORT=9001
TMDB_MEDIA_HOST_PORT=9002
TMDB_POSTGRES_HOST_PATH=<postgres-data-host-path>
TMDB_CONFIG_HOST_PATH=<config-host-path>
TMDB_MEDIA_HOST_PATH=<media-host-path>

# PostgreSQL database name. Keep the existing value when reusing a data volume.
POSTGRES_DB=tmdb
# PostgreSQL login/owner used by the server health check and bootstrap. Keep
# the current owner name for an existing database; changing it requires a
# controlled PostgreSQL role migration.
POSTGRES_USER=tmdb
# Keep the current database password here; do not rotate it as part of a
# Compose-only update.
POSTGRES_PASSWORD=<keep-existing-database-password>
# Least-privilege application roles. These roles are created by the PostgreSQL
# bootstrap. For an existing deployment, use the current database password for
# each role unless you intentionally perform a role-password rotation.
TMDB_MIGRATOR_USER=migrator
TMDB_MIGRATOR_PASSWORD=<keep-existing-role-password-or-set-a-dedicated-one>
TMDB_API_READER_USER=api_reader
TMDB_API_READER_PASSWORD=<keep-existing-role-password-or-set-a-dedicated-one>
TMDB_API_JOB_SUBMITTER_USER=api_job_submitter
TMDB_API_JOB_SUBMITTER_PASSWORD=<keep-existing-role-password-or-set-a-dedicated-one>
TMDB_INGEST_WRITER_USER=ingest_writer
TMDB_INGEST_WRITER_PASSWORD=<keep-existing-role-password-or-set-a-dedicated-one>
TMDB_IMAGE_WRITER_USER=image_writer
TMDB_IMAGE_WRITER_PASSWORD=<keep-existing-role-password-or-set-a-dedicated-one>
TMDB_MONITOR_USER=monitor
TMDB_MONITOR_PASSWORD=<keep-existing-role-password-or-set-a-dedicated-one>
# PostgreSQL's internal data directory; leave this container path unchanged.
PGDATA=/var/lib/postgresql/18/docker
# First-cluster initialization settings, including checksums and SCRAM auth.
POSTGRES_INITDB_ARGS=--data-checksums --encoding=UTF8 --auth-local=scram-sha-256 --auth-host=scram-sha-256

# Public catalog API listener inside the API container.
TMDB_API_BIND=0.0.0.0:8080
# Private admin/Prometheus metrics listener inside the API container.
TMDB_ADMIN_BIND=0.0.0.0:8081
# Embedded static media listener inside the media container.
TMDB_MEDIA_BIND=0.0.0.0:8090
# Colorized, readable Docker-terminal logs. Set to json only for a log collector.
TMDB_LOG_FORMAT=pretty
# Normal lifecycle/failure visibility; use debug temporarily for each job claim and success.
TMDB_LOG_LEVEL=info
# TMDB v4 read token used only to mirror upstream TMDB data.
TMDB_READ_ACCESS_TOKEN=<paste-tmdb-read-access-token>
# Key required for the private /metrics endpoint; use at least 32 characters.
TMDB_ADMIN_API_KEY=<choose-an-admin-key-at-least-32-characters>

# Upstream TMDB API base URL; normally leave this unchanged.
TMDB_API_BASE_URL=https://api.themoviedb.org/3
# Public media URL placed in image API responses when local media is enabled.
TMDB_MEDIA_BASE_URL=http://<server-host>:9002/media
# Optional existing Trawl URL used only if upstream image downloads are challenged; leave blank otherwise.
TMDB_TRAWL_BASE_URL=
# true downloads and serves local media; false returns original TMDB image URLs.
ALLOW_LOCAL_MEDIA=true

# Maximum uncompressed daily export accepted by the streaming downloader (8 GiB hard cap).
TMDB_DAILY_EXPORT_MAX_BYTES=8589934592
# Image downloader safety policy. The allowed hosts are TMDB image origins;
# challenge fallback traffic uses TMDB_TRAWL_BASE_URL when configured.
TMDB_IMAGE_MAX_BYTES=20971520
TMDB_IMAGE_MAX_REDIRECTS=3
TMDB_IMAGE_TIMEOUT_SECONDS=30
TMDB_IMAGE_ALLOWED_HOSTS=image.tmdb.org,media.themoviedb.org

# Maximum upstream TMDB requests started per second (TMDB's conservative ceiling is 40).
TMDB_RATE_LIMIT=40
# Maximum simultaneous upstream TMDB HTTP connections; also caps the main worker's
# automatic 1-8 parallel ingestion loops.
TMDB_MAX_CONNECTIONS=20
# Maximum attempts before an upstream job becomes a dead letter.
TMDB_MAX_ATTEMPTS=4
# Per-request timeout for upstream TMDB calls.
TMDB_REQUEST_TIMEOUT_SECONDS=30
# Stable lease ID for the main migration, ingest, and scheduler worker.
TMDB_WORKER_ID=tmdb-worker-primary
# Base lease ID for the media worker's internal download workers.
TMDB_IMAGE_WORKER_ID=tmdb-media-primary
# Parallel media download workers inside the single media container (1-32).
TMDB_IMAGE_WORKER_CONCURRENCY=4
# Job lease duration before another worker may recover abandoned work.
TMDB_WORKER_LEASE_SECONDS=60
# How often a running worker renews its job lease.
TMDB_WORKER_HEARTBEAT_SECONDS=15
# Idle delay before a worker polls PostgreSQL for another job.
TMDB_WORKER_IDLE_POLL_MS=500
# Enables the main worker's durable scheduler.
TMDB_ENABLE_SCHEDULER=true
# Scheduler polling interval in seconds.
TMDB_SCHEDULER_INTERVAL_SECONDS=60
# Enables the scheduler's durable daily export jobs. Full catalog scans are
# explicit admin jobs and are never started implicitly on worker boot.
TMDB_ENABLE_DAILY_EXPORT=true
