# Copy to .env and chmod 600.
TMDB_ENVIRONMENT=production
TZ=America/New_York

# Database.
POSTGRES_DB=tmdb
POSTGRES_USER=tmdb
POSTGRES_PASSWORD=<database-password>

# TMDB.
TMDB_READ_ACCESS_TOKEN=<tmdb-read-access-token>
TMDB_ADMIN_API_KEY=<admin-key-at-least-32-characters>
TMDB_API_BASE_URL=https://api.themoviedb.org/3
TMDB_RATE_LIMIT=40
TMDB_MAX_CONNECTIONS=20

# Local media.
ALLOW_LOCAL_MEDIA=true
TMDB_MEDIA_BASE_URL=http://<server-host>:9002/media
TMDB_TRAWL_BASE_URL=

# Workers.
TMDB_WORKER_ID=tmdb-worker-primary
TMDB_IMAGE_WORKER_ID=tmdb-media-primary
TMDB_IMAGE_WORKER_CONCURRENCY=4
