# Behavior-only production settings.  Filesystem roots are fixed inside the
# containers; edit the host side of the bind mounts in deploy/compose.compact.yaml.
COMPOSE_PROJECT_NAME=tmdb

ALLOW_LOCAL_MEDIA=true
# Replace the reserved example hostnames with addresses reachable by your app.
TMDB_MEDIA_BASE_URL=http://media.example.invalid:8090/media
TMDB_TRAWL_BASE_URL=http://trawl.example.invalid:8191
TMDB_API_BASE_URL=https://api.themoviedb.org/3
TMDB_RATE_LIMIT=45
TMDB_MAX_CONNECTIONS=20
TMDB_MAX_ATTEMPTS=4
TMDB_REQUEST_TIMEOUT_SECONDS=30
TMDB_ENABLE_SCHEDULER=true
TMDB_SCHEDULER_INTERVAL_SECONDS=60
TMDB_ENABLE_DAILY_EXPORT=true
