# Development-only PostgreSQL fixture. The full four-service deployment uses
# the repository-root .env.example as its template instead.
# These fixture credentials are intentionally non-secret and must not be used
# for production.

COMPOSE_PROJECT_NAME=tmdb_rust_foundation_test
TMDB_DEV_PG_PORT=55432
TMDB_ENVIRONMENT=development
TZ=America/New_York
POSTGRES_DB=tmdb
POSTGRES_USER=tmdb_owner
POSTGRES_PASSWORD=tmdb-development-owner
TMDB_MIGRATOR_USER=migrator
TMDB_MIGRATOR_PASSWORD=tmdb-development-migrator
TMDB_API_READER_USER=api_reader
TMDB_API_READER_PASSWORD=tmdb-development-reader
TMDB_API_JOB_SUBMITTER_USER=api_job_submitter
TMDB_API_JOB_SUBMITTER_PASSWORD=tmdb-development-submitter
TMDB_INGEST_WRITER_USER=ingest_writer
TMDB_INGEST_WRITER_PASSWORD=tmdb-development-ingest
TMDB_IMAGE_WRITER_USER=image_writer
TMDB_IMAGE_WRITER_PASSWORD=tmdb-development-image
TMDB_MONITOR_USER=monitor
TMDB_MONITOR_PASSWORD=tmdb-development-monitor
PGDATA=/var/lib/postgresql/18/docker
POSTGRES_INITDB_ARGS=--data-checksums --encoding=UTF8 --auth-local=scram-sha-256 --auth-host=scram-sha-256

# Settings used when running an application process manually against the
# fixture. The dev Compose file itself starts PostgreSQL only.
TMDB_API_BIND=127.0.0.1:8080
TMDB_ADMIN_BIND=127.0.0.1:8081
TMDB_MEDIA_BIND=127.0.0.1:8090
TMDB_API_BASE_URL=https://api.themoviedb.org/3
TMDB_LOG_FORMAT=pretty
TMDB_LOG_LEVEL=info
TMDB_RATE_LIMIT=40
TMDB_MAX_CONNECTIONS=20
TMDB_MAX_ATTEMPTS=4
TMDB_REQUEST_TIMEOUT_SECONDS=30
TMDB_ENABLE_SCHEDULER=false
TMDB_SCHEDULER_INTERVAL_SECONDS=60
TMDB_ENABLE_DAILY_EXPORT=false
ALLOW_LOCAL_MEDIA=false
TMDB_MEDIA_BASE_URL=http://127.0.0.1:8090/media
# TMDB_READ_ACCESS_TOKEN is intentionally absent. Supply it only through a
# mode-600 runtime secret when running an upstream ingest or image test.
# TMDB_TRAWL_BASE_URL=http://<trawl-host>:8191
