# Non-secret settings for the PostgreSQL-only development fixture.
# bootstrap-dev.ps1 and verify-postgres.ps1 use this file with compose.dev.yaml.

COMPOSE_PROJECT_NAME=tmdb_rust_foundation_test
TMDB_ENVIRONMENT=development
TMDB_POSTGRES_HOST=127.0.0.1
TMDB_POSTGRES_PORT=55432
TMDB_POSTGRES_DATABASE=tmdb

# Settings used when running a Rust process against the fixture manually.
TMDB_API_BASE_URL=https://api.themoviedb.org/3
TMDB_RATE_LIMIT=45
TMDB_MAX_CONNECTIONS=20
TMDB_MAX_ATTEMPTS=4
TMDB_REQUEST_TIMEOUT_SECONDS=30
TMDB_ENABLE_SCHEDULER=false
TMDB_ENABLE_DAILY_EXPORT=false
ALLOW_LOCAL_MEDIA=false
TMDB_MEDIA_BASE_URL=http://127.0.0.1:8090/media
# TMDB_TRAWL_BASE_URL=http://<trawl-host>:8191

# Role passwords are generated as files under deploy/secrets/.
# TMDB_DIRECT_DB_PASSWORD_FILE=/run/secrets/ingest_writer_password
